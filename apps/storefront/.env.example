# Storefront Next.js (BOVINE) - copie para .env.local e preencha.
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# URL interna usada pelo rewrite /static (na VPS: http://127.0.0.1:9000)
MEDUSA_INTERNAL_URL=http://127.0.0.1:9000
